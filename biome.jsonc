{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // The extended presets already include `**`, so only exclusions belong here.
    // Reference material, not source: the prototype the app is ported from, the
    // installed agent skills, the PRD, the specs/plans/trackers and the code-graph
    // index are read as documents. Formatting them churns files no reviewer reads
    // as code, and the prototype's markup is the port target, not a style to
    // reformat. Generated files that are gitignored are already covered by
    // `vcs.useIgnoreFile`; the migration folder is committed, so it is named here:
    // drizzle-kit rewrites its snapshot on the next `db:generate`, and formatting
    // it only buys churn (`.gitattributes` marks it generated for review).
    // `apps/native` is ADR-002: the Expo app is untouched in the first release, no
    // gate builds or type-checks it yet, so reformatting it here would be an
    // unverifiable change to code this release does not ship. It returns to the
    // gate when native work starts.
    "includes": [
      "!apps/native",
      "!masterscorner.html",
      "!packages/db/src/migrations",
      "!product-vision.md",
      "!.agents",
      "!.codegraph",
      "!.omp",
      "!.tmp",
      "!docs",
      "!tasks"
    ]
  },
  "linter": {
    "rules": {
      "performance": {
        // Namespace imports are load-bearing in three places: the Alchemy/Effect
        // configuration (`import * as Alchemy`, `* as Cloudflare`, `* as Config`,
        // `* as Effect`), Better Auth's drizzle adapter (`import * as schema`), and
        // Drizzle's `defineRelations(schema)` — the last two take the whole module
        // object as an argument. Tree shaking is irrelevant for server-side code.
        "noNamespaceImport": "off",
        // The flagged files are single-purpose entry points, not aggregators:
        // `apps/server/src/env.server.ts` re-exports the Workers binding,
        // `packages/db/src/schema/index.ts` re-exports the tables, and
        // `packages/ui/src/lib/utils.ts` re-exports the `cn` helper from the
        // package of that name so components import one workspace path.
        "noBarrelFile": "off"
      }
    }
  },
  "overrides": [
    {
      // Template screens SPEC-platform §2.2 leaves to Task 5 (the auth forms) and
      // Task 3/14 (the demo home). Their findings stay visible as warnings, so a
      // green gate still means "the code this release ships is clean" without
      // editing files that belong to another task.
      "includes": [
        "apps/web/src/components/sign-in-form.tsx",
        "apps/web/src/components/sign-up-form.tsx",
        "apps/web/src/components/user-menu.tsx",
        "apps/web/src/routes/index.tsx",
        "apps/web/src/routes/login.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "warn"
          },
          "style": {
            "noNestedTernary": "warn"
          },
          "suspicious": {
            "noShadow": "warn",
            "noUnnecessaryConditions": "warn"
          }
        }
      }
    },
    {
      // Files whose finding is decided by their caller or by TypeScript's own
      // syntax rather than by the file itself: module augmentation has no
      // non-namespace form (`cloudflare-env.d.ts`), the env accessor asserts a
      // value the generated schema guarantees at build time, the tRPC context must
      // stay a type alias because an interface has no implicit index signature
      // (the server's context factory fails to assign it otherwise), `Label`
      // receives its association from the caller's `htmlFor`, and
      // `input-group.tsx` is an unused template primitive whose semantic-element
      // rewrite belongs with the screen that adopts it.
      "includes": [
        "apps/server/cloudflare-env.d.ts",
        "apps/web/src/env.public.ts",
        "packages/api/src/context.ts",
        "packages/ui/src/components/input-group.tsx",
        "packages/ui/src/components/label.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "warn",
            "noNoninteractiveElementInteractions": "warn",
            "useKeyWithClickEvents": "warn",
            "useSemanticElements": "warn"
          },
          "performance": {
            "noJsxPropsBind": "warn"
          },
          "style": {
            "noNamespace": "warn",
            "noNonNullAssertion": "warn",
            "useConsistentTypeDefinitions": "warn"
          },
          "suspicious": {
            "noShadow": "warn"
          }
        }
      }
    }
  ]
}
