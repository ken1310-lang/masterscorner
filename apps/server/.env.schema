# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Direct (unpooled) connection string, written by `neon env pull` alongside
# DATABASE_URL. Migrations run over this one: PgBouncer runs in transaction
# mode, where DDL and session state fail in ways that never name pooling.
# @optional @type=string(minLength=1)
DATABASE_URL_UNPOOLED=

# The Neon branch this environment's values came from, written by `neon env
# pull`. It names the branch in plain text, so the production deploy guard can
# refuse a deploy that is holding development values.
# @optional @type=string(minLength=1)
NEON_BRANCH=

# Pinned hosts for the fail-closed `alchemy dev` guard. They must match the
# hostnames in DATABASE_URL and AWS_ENDPOINT_URL_S3; a production env copied
# into this file fails the guard even if NEON_BRANCH says development.
# @optional @type=string(minLength=1)
NEON_DEVELOPMENT_DATABASE_HOST=

# @optional @type=string(minLength=1)
NEON_DEVELOPMENT_STORAGE_HOST=

# Object storage for master and class media (declared in neon.ts, consumed by
# the media module). `neon env pull` writes all four for the pinned branch.
# @optional @type=string(minLength=1)
AWS_ACCESS_KEY_ID=

# @optional @type=string(minLength=1)
AWS_SECRET_ACCESS_KEY=

# @optional @type=url
AWS_ENDPOINT_URL_S3=

# @optional @type=string(minLength=1)
AWS_REGION=
