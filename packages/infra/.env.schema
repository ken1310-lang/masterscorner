# @import(../../apps/server/, pick=[NODE_ENV, DATABASE_URL, NEON_BRANCH, NEON_DEVELOPMENT_DATABASE_HOST, NEON_DEVELOPMENT_STORAGE_HOST, CORS_ORIGIN, BETTER_AUTH_SECRET, AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION])
# @defaultRequired=false
# @defaultSensitive=true
# ---
ALCHEMY_PASSWORD=

# Cloudflare credentials Alchemy uses to deploy and to serve `alchemy dev`. The
# provider reads them from the environment instead of the `~/.alchemy` profile
# ("Cloudflare: using environment variables …" in its log). Account-scoped
# token: `/user/tokens/verify` rejects it, `/accounts/<id>/…` accepts it.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
