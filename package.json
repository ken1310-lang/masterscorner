{
  "name": "my-better-t-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "@types/node": "^26.4.1",
      "varlock": "1.18.0",
      "@cloudflare/workers-types": "^5.20260906.1",
      "@trpc/server": "^11.19.0",
      "better-auth": "1.7.7",
      "@tanstack/react-query": "^5.104.2",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@trpc/tanstack-react-query": "^11.19.0",
      "@trpc/client": "^11.19.0",
      "@tanstack/react-form": "^1.33.5",
      "@better-auth/expo": "1.7.7",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:server": "turbo run dev:bare -F hono --",
    "db:push": "turbo run db:push -F @my-better-t-app/db --",
    "db:studio": "turbo run db:studio -F @my-better-t-app/db --",
    "db:generate": "turbo run db:generate -F @my-better-t-app/db --",
    "db:migrate": "turbo run db:migrate -F @my-better-t-app/db --",
    "deploy": "turbo run deploy -F @my-better-t-app/infra --",
    "destroy": "turbo run destroy -F @my-better-t-app/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "catalog:",
    "@my-better-t-app/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
